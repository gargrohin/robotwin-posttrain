@@ -354,35 +354,106 @@ def _extract_all_frames_ffmpeg(video_path: str) -> tuple[np.ndarray, np.ndarray]
         raise ValueError(f"Failed to extract frames from {video_path}: {e}")
 
 
+def _decode_pyav_packets(stream, packets: list, index_set: set[int]) -> dict[int, np.ndarray]:
+    """Decode the frames in ``index_set`` (plus the last frame), feeding only needed packets.
+
+    Frame i is the i-th decoded frame. When every packet has a pts, pts increase in decode
+    order (no frame reordering) and the first packet is a keyframe, frame i is packet i, and
+    decoding from the last keyframe at or before i reproduces it exactly, so the packets
+    between requested frames are skipped. Otherwise (or if any packet doesn't yield exactly
+    one frame) all packets are decoded in order.
+
+    Returns {frame index: RGB array}. If an index is past the end, the last decoded frame is
+    also stored, under key -1.
+    """
+    ctx = stream.codec_context
+    pts = [p.pts for p in packets]
+    n = len(packets)
+    if (
+        n
+        and packets[0].is_keyframe
+        and None not in pts
+        and all(a < b for a, b in zip(pts, pts[1:]))
+    ):
+        pts_to_idx = {p: i for i, p in enumerate(pts)}
+        past_end = any(i >= n for i in index_set)
+        targets = sorted({i for i in index_set if i < n} | ({n - 1} if past_end else set()))
+        frames: dict[int, np.ndarray] = {}
+        fed = decoded = 0
+        next_packet = 0  # packet that continues the decoder's current state
+        ok = True
+        for k in targets:
+            if k in frames:
+                continue
+            start = k
+            while not packets[start].is_keyframe:
+                start -= 1
+            if start <= next_packet <= k:
+                start = next_packet
+            elif fed:
+                # Jump to a keyframe: drain and reset the decoder first.
+                out = ctx.decode(None)
+                ctx.flush_buffers()
+                decoded += len(out)
+                ok &= all(f.pts in pts_to_idx for f in out)
+            for i in range(start, k + 1):
+                out = ctx.decode(packets[i])
+                fed += 1
+                decoded += len(out)
+                for f in out:
+                    idx = pts_to_idx.get(f.pts)
+                    if idx is None:
+                        ok = False
+                    elif idx in index_set or (past_end and idx == n - 1):
+                        frames[idx] = f.to_ndarray(format="rgb24")
+            next_packet = k + 1
+        out = ctx.decode(None)
+        decoded += len(out)
+        ok &= all(f.pts in pts_to_idx for f in out)
+        for f in out:
+            idx = pts_to_idx.get(f.pts)
+            if idx in index_set or (past_end and idx == n - 1):
+                frames[idx] = f.to_ndarray(format="rgb24")
+        if ok and fed == decoded and all(k in frames for k in targets):
+            if past_end:
+                frames[-1] = frames[n - 1]
+            return frames
+        ctx.flush_buffers()
+
+    # Sequential decode of every packet, as container.decode() does.
+    frames = {}
+    av_frame = None
+    frame_idx = -1
+    for packet in packets + [None]:
+        for av_frame in ctx.decode(packet):
+            frame_idx += 1
+            if frame_idx in index_set:
+                frames[frame_idx] = av_frame.to_ndarray(format="rgb24")
+    if av_frame is not None and any(i > frame_idx for i in index_set):
+        frames[-1] = frames.get(frame_idx)
+        if frames[-1] is None:
+            frames[-1] = av_frame.to_ndarray(format="rgb24")
+    return frames
+
+
