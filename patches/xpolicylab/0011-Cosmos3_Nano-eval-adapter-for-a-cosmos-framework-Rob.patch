@@ -0,0 +1,420 @@
+"""XPolicyLab adapter for a Cosmos3-Nano action policy post-trained on RoboTwin (aloha_agilex).
+
+The model is NVIDIA's Cosmos3-Nano (cosmos-framework) fine-tuned with the
+``action_policy_robotwin_nano`` recipe. For every policy query the adapter rebuilds the
+sample that the training data path (``RoboTwinLeRobotDataset`` + ``ActionTransformPipeline``)
+builds for one window, from the current observation:
+
+* video: head camera on top, both wrist cameras at half size below
+  (``compose_robotwin_views``), as frame 0 of ``chunk_length + 1`` frames. The other frames
+  stay black: the model conditions on frame 0 only and generates the rest.
+* action: ``chunk_length + 1`` rows of 14-D absolute joint positions
+  ``[left joints(6), left gripper, right joints(6), right gripper]``. Row 0 is the current
+  state, normalized with the training stats (quantile q01/q99); the other rows are generated.
+* prompt: the episode instruction in the training JSON prompt format (domain ``robotwin``,
+  15 fps, ``concat_view``), with idle frames 0 as NVIDIA's LIBERO policy server does.
+
+The model denoises the future video and the action chunk together ("wam" mode, as trained).
+The adapter drops row 0, denormalizes the rest and returns them as absolute joint targets, in
+the same per-step dict format as the GR00T_N17 adapter.
+
+What must match training (fps, chunk length, resolution tier, prompt format, normalization
+stats) is read from the run's ``config.yaml``. Weights come from the DCP checkpoint
+``<run_dir>/checkpoints/iter_<N>`` (EMA weights by default), loaded the way the docs load
+LIBERO checkpoints (``OmniInference`` with the experiment name and the Wan VAE path).
+
+Runs in the cosmos-framework environment, not in GR00T's.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import statistics
+import tempfile
+import time
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+import yaml
+
+import cosmos_framework
+from cosmos_framework.data.generator.action.action_normalization import (
+    denormalize_action,
+    load_action_stats,
+    normalize_action,
+)
+from cosmos_framework.data.generator.action.datasets.robotwin_lerobot_dataset import (
+    ROBOTWIN_ACTION_DIM,
+    ROBOTWIN_VIEW_DESCRIPTION,
+    compose_robotwin_views,
+)
+from cosmos_framework.data.generator.action.utils.domain_utils import get_domain_id
+from cosmos_framework.data.generator.action.utils.transforms import ActionTransformPipeline
+from cosmos_framework.data.generator.joint_dataloader import IterativeJointDataLoader
+from XPolicyLab.model_template import ModelTemplate
+from XPolicyLab.utils.checkpoint_resolver import resolve_checkpoint_root
+from XPolicyLab.utils.process_data import get_robot_action_dim_info
+
+_POLICY_DIR = Path(__file__).resolve().parent
+_CHECKPOINTS_DIR = _POLICY_DIR / "checkpoints"
+COSMOS_ROOT = Path(cosmos_framework.__file__).resolve().parents[1]
+
+# Head first, then left and right wrist: the order compose_robotwin_views expects.
+CAMERA_CANDIDATES = (
+    ("cam_head", "cam_high", "head_camera"),
+    ("cam_left_wrist", "left_camera"),
+    ("cam_right_wrist", "right_camera"),
+)
+TRAIN_CAMERA_HW = (240, 320)  # every camera of the training data (RoboTwin-mix200 meta/info.json)
+STATE_KEYS = ("left_arm_joint_state", "left_ee_joint_state", "right_arm_joint_state", "right_ee_joint_state")
+
+
+def action_layout(env_cfg_type: str) -> tuple[tuple[str, int, int], ...]:
+    """(state/action key, start, end) per part of the flat vector, from the robot's registered dims.
+
+    The order (left arm, left gripper, right arm, right gripper) is the training data's and the
+    simulator's; the total must be the model's 14.
+    """
+    dims = get_robot_action_dim_info(env_cfg_type)
+    sizes = (dims["arm_dim"][0], dims["ee_dim"][0], dims["arm_dim"][1], dims["ee_dim"][1])
+    if len(dims["arm_dim"]) != 2 or sum(sizes) != ROBOTWIN_ACTION_DIM:
+        raise ValueError(f"{env_cfg_type}: dims {dims} do not match the model's {ROBOTWIN_ACTION_DIM}-D action")
+    starts = np.cumsum((0,) + sizes[:-1])
+    return tuple((key, int(start), int(start + size)) for key, start, size in zip(STATE_KEYS, starts, sizes))
+
+
+# ---- run config and checkpoint ---------------------------------------------
+
+
+def resolve_run_dir(model_cfg: dict[str, Any]) -> Path:
+    """The Cosmos training output dir (config.yaml + checkpoints/): run_dir, else ckpt_name as a path,
+    else checkpoints/<ckpt_name> under this policy (e.g. a symlink), per the shared resolver."""
+    return resolve_checkpoint_root(model_cfg, _CHECKPOINTS_DIR, policy_dir=_POLICY_DIR, explicit_keys=("run_dir",))
+
+
+def load_run_settings(run_dir: str | Path) -> dict[str, Any]:
+    """The training-data settings and model paths recorded in a run's config.yaml."""
+    config = yaml.safe_load((Path(run_dir) / "config.yaml").read_text())
+    datasets = config["dataloader_train"]["dataloader"]["datasets"]
+    if len(datasets) != 1:
+        raise ValueError(f"expected one training dataset in {run_dir}/config.yaml, got {list(datasets)}")
+    (entry,) = datasets.values()
+    dataset = entry["dataset"]
+    if not dataset["_target_"].endswith(".get_action_robotwin_sft_dataset"):
+        raise ValueError(f"{run_dir} was not trained on the RoboTwin dataset: {dataset['_target_']}")
+    return {
+        "dataset": dataset,
+        "experiment": config["job"]["name"],
+        "vae_path": config["model"]["config"]["tokenizer"]["vae_path"],
+        "max_action_dim": int(config["model"]["config"]["max_action_dim"]),
+    }
+
+
+def resolve_checkpoint(run_dir: str | Path, checkpoint_num: Any) -> Path:
+    """``<run_dir>/checkpoints/iter_<N>`` for N = checkpoint_num, or the latest for "last".
+
+    Refuses a checkpoint newer than ``latest_checkpoint.txt``: the trainer writes that file
+    only after every shard of a save is on disk, so a newer folder may still be partial.
+    """
+    checkpoints = Path(run_dir) / "checkpoints"
+    latest_file = checkpoints / "latest_checkpoint.txt"
+    if not latest_file.is_file():
+        raise FileNotFoundError(f"{latest_file} not found: no finished checkpoint in {run_dir}")
+    latest = latest_file.read_text().strip()  # e.g. iter_000001500
+    if checkpoint_num in (None, "last", "latest"):
+        name = latest
+    else:
+        iteration = int(str(checkpoint_num).removeprefix("iter_"))
+        if iteration > int(latest.removeprefix("iter_")):
+            raise FileNotFoundError(f"checkpoint {iteration} is newer than the last finished save ({latest})")
+        name = f"iter_{iteration:09d}"
+    path = checkpoints / name
+    if not (path / "model").is_dir():
+        raise FileNotFoundError(f"{path}/model not found")
+    return path
+
+
+def checkpoint_iteration(checkpoint: Path) -> int:
+    return int(checkpoint.name.removeprefix("iter_"))
+
+
+# ---- observation -> model input (CPU) ----------------------------------------
+
+
+def parse_observation(
+    obs: dict[str, Any], layout: tuple[tuple[str, int, int], ...], default_prompt: str
+) -> tuple[list[np.ndarray], np.ndarray, str]:
+    """XPolicyLab observation -> ([head, left wrist, right wrist] uint8 HxWx3 RGB, state [14], prompt)."""
+    vision = obs.get("vision", {})
+    images = []
+    for candidates in CAMERA_CANDIDATES:
+        name = next((c for c in candidates if c in vision), None)
+        if name is None:
+            raise KeyError(f"observation has none of the cameras {candidates}; got {list(vision)}")
+        image = vision[name]["color"] if isinstance(vision[name], dict) else vision[name]
+        image = np.asarray(image)
+        if image.dtype != np.uint8 or image.shape != (*TRAIN_CAMERA_HW, 3):
+            raise ValueError(
+                f"{name}: expected uint8 {TRAIN_CAMERA_HW + (3,)} RGB as in training, got {image.dtype} {image.shape}"
+            )
+        images.append(image)
+
+    state = obs["state"]
+    parts = []
+    for key, start, end in layout:
+        value = np.asarray(state[key], dtype=np.float32).reshape(-1)
+        if value.shape[0] != end - start:
+            raise ValueError(f"state {key}: expected {end - start} values, got {value.shape[0]}")
+        parts.append(value)
+
+    prompt = obs.get("instruction") or (obs.get("instructions") or [None])[0] or default_prompt
+    return images, np.concatenate(parts), str(prompt).strip()
+
+
+class InputBuilder:
+    """Builds the model input for one observation as the training data path builds one window."""
+
+    def __init__(self, dataset_cfg: dict[str, Any]):
+        ds = dataset_cfg
+        if ds["mode"] != "wam" or not ds["use_state"] or ds["action_normalization"] != "quantile":
+            raise ValueError(
+                "this adapter serves the wam + use_state + quantile recipe; the run used "
+                f"mode={ds['mode']} use_state={ds['use_state']} normalization={ds['action_normalization']}"
+            )
+        self.fps = float(ds["fps"])
+        self.chunk_length = int(ds["chunk_length"])
+        self.resolution = ds["resolution"]
+        # Same loading as RoboTwinLeRobotDataset._load_norm_stats.
+        self.stats = {k: torch.from_numpy(v).float() for k, v in load_action_stats(ds["action_stats_path"]).items()}
+        # The training transform, minus caption dropout and tokenization: at inference the
+        # model tokenizes the prompt itself (same tokenize_caption call as the training transform).
+        self.transform = ActionTransformPipeline(
+            tokenizer_config=None,
+            cfg_dropout_rate=0.0,
+            max_action_dim=int(ds["max_action_dim"]),
+            append_viewpoint_info=ds["append_viewpoint_info"],
+            append_duration_fps_timestamps=ds["append_duration_fps_timestamps"],
+            append_resolution_info=ds["append_resolution_info"],
+            append_idle_frames=ds["append_idle_frames"],
+            format_prompt_as_json=ds["format_prompt_as_json"],
+        )
+        self.domain_id = get_domain_id("robotwin")  # RoboTwinLeRobotDataset._domain_name
+
+    def build(self, images: list[np.ndarray], state: np.ndarray, prompt: str) -> dict[str, Any]:
+        """One transformed sample, as ActionSFTDataset returns it in training (prompt as a JSON string)."""
+        frames = self.chunk_length + 1
+        views = []
+        for image in images:
+            clip = torch.zeros((frames, 3, *image.shape[:2]), dtype=torch.uint8)  # [T,3,H,W]
+            clip[0] = torch.from_numpy(image.copy()).permute(2, 0, 1)  # copy: decoded arrays are read-only
+            views.append(clip.float().div_(255.0))
+        video = compose_robotwin_views(*views)  # [T,3,3H/2,W], as RoboTwinLeRobotDataset._build_item
+
+        action = torch.zeros((frames, ROBOTWIN_ACTION_DIM), dtype=torch.float32)  # [T,14]
+        action[0] = torch.from_numpy(state)
+        action = normalize_action(action, "quantile", self.stats)
+        action[1:] = 0.0  # generated rows: replaced by noise when sampling
+
+        # As ActionBaseDataset._build_result, except idle_frames (unknown before acting): 0.
+        sample = {
+            "ai_caption": prompt,
+            "video": (video * 255.0).clamp(0.0, 255.0).to(torch.uint8).permute(1, 0, 2, 3),  # [3,T,H,W]
+            "action": action,
+            "conditioning_fps": torch.tensor(self.fps, dtype=torch.long),
+            "mode": "wam",
+            "domain_id": torch.tensor(self.domain_id, dtype=torch.long),
+            "viewpoint": "concat_view",
+            "idle_frames": torch.tensor(0, dtype=torch.long),
+            "additional_view_description": ROBOTWIN_VIEW_DESCRIPTION,
+        }
+        sample = self.transform(sample, self.resolution)
+        if isinstance(sample["ai_caption"], dict):
+            sample["ai_caption"] = json.dumps(sample["ai_caption"])  # as TextTokenizerTransform does
+        return sample
+
+
+def build_data_batch(sample: dict[str, Any]) -> dict[str, Any]:
+    """One sample -> a batch of one (as action_policy_server_robolab._build_data_batch_from_sample)."""
+    batch: dict[str, Any] = {}
+    for key, value in sample.items():
+        if key in IterativeJointDataLoader._MULTI_ITEM_KEYS:
+            batch[key] = [[value]]
+        elif isinstance(value, torch.Tensor):
+            batch[key] = [value.unsqueeze(0)]
+        else:
+            batch[key] = [value]
+    return batch
+
+
+# ---- model output -> actions (CPU) ----------------------------------------------
+
+
+def decode_actions(rows: torch.Tensor, stats: dict[str, torch.Tensor]) -> np.ndarray:
+    """Generated action rows [T+1, >=14] (normalized) -> absolute joint targets [T, 14].
+
+    Keeps the 14 real channels (the model pads to max_action_dim), drops row 0 (the given
+    state) and inverts the quantile normalization.
+    """
+    rows = rows.detach().float().cpu()[:, :ROBOTWIN_ACTION_DIM]
+    return denormalize_action(rows[1:], "quantile", stats).numpy().astype(np.float32)
+
+
+def to_env_actions(chunk: np.ndarray, layout: tuple[tuple[str, int, int], ...]) -> list[dict[str, np.ndarray]]:
+    """[T, 14] -> one dict per step, the format the GR00T_N17 adapter returns."""
+    return [{key: step[start:end].copy() for key, start, end in layout} for step in np.asarray(chunk, dtype=np.float32)]
+
+
+# ---- model loading (GPU) ---------------------------------------------------------
+
+
+def load_policy_model(
+    checkpoint: Path,
+    *,
+    experiment: str,
+    vae_path: str,
+    dataset_cfg: dict[str, Any],
+    use_ema_weights: bool,
+    use_torch_compile: bool,
+) -> Any:
+    """Load the DCP checkpoint with OmniInference, as docs/action_policy_libero_posttrain.md does."""
+    from cosmos_framework.inference.common.init import init_output_dir, init_script
+
+    init_script()
+    from cosmos_framework.inference.args import OmniSetupOverrides
+    from cosmos_framework.inference.inference import OmniInference
+    from cosmos_framework.scripts.action_policy_server_utils import maybe_init_distributed
+
+    # The experiment config reads these to build the training dataloader (never built here),
+    # and fails to load without them.
+    os.environ.setdefault("ROBOTWIN_ROOT", dataset_cfg["root"])
+    os.environ.setdefault("ROBOTWIN_INDEX_CACHE", dataset_cfg["index_cache_path"])
+    # cosmos-framework configs use repo-relative paths (e.g. the Qwen3-VL config JSON).
+    os.chdir(COSMOS_ROOT)
+    maybe_init_distributed()  # single-rank process group, as NVIDIA's policy servers
+
+    overrides = OmniSetupOverrides.model_validate(
+        {
+            "checkpoint_path": str(checkpoint),
+            "experiment": experiment,
+            "experiment_overrides": [f"model.config.tokenizer.vae_path={vae_path}"],
+            "use_ema_weights": use_ema_weights,
+            "output_dir": Path(tempfile.gettempdir()) / "cosmos3_xpolicylab" / f"pid{os.getpid()}",
+            "sampler": "unipc",
+            "guardrails": False,  # policy serving never runs the output guardrails
+            "dp_shard_size": 1,
+            "use_torch_compile": use_torch_compile,
+        }
+    )
+    setup = overrides.build_setup()
+    init_output_dir(setup.output_dir)
+    pipe = OmniInference.create(setup)
+    pipe.model.eval()
+    return pipe.model
