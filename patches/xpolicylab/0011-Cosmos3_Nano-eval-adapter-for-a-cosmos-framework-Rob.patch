+# ---- XPolicyLab Model ---------------------------------------------------------------
+
+
+class Model(ModelTemplate):
+    def __init__(self, model_cfg: dict[str, Any]):
+        if model_cfg.get("action_type", "joint") != "joint":
+            raise ValueError(f"Cosmos3_Nano predicts absolute joint positions; got action_type={model_cfg['action_type']!r}")
+        run_dir = resolve_run_dir(model_cfg)
+        settings = load_run_settings(run_dir)
+        checkpoint = resolve_checkpoint(run_dir, model_cfg.get("checkpoint_num", "last"))
+        experiment = model_cfg.get("experiment") or settings["experiment"]
+        print(f"[Cosmos3_Nano] loading {checkpoint} (experiment {experiment}, EMA={model_cfg.get('use_ema_weights', True)})", flush=True)
+        start = time.monotonic()
+        model = load_policy_model(
+            checkpoint,
+            experiment=experiment,
+            vae_path=settings["vae_path"],
+            dataset_cfg=settings["dataset"],
+            use_ema_weights=bool(model_cfg.get("use_ema_weights", True)),
+            use_torch_compile=bool(model_cfg.get("use_torch_compile", True)),
+        )
+        print(f"[Cosmos3_Nano] loaded in {time.monotonic() - start:.0f} s", flush=True)
+        self._setup(model_cfg, settings, model)
+        self.checkpoint = checkpoint
+        self._warmup(int(model_cfg.get("warmup_calls", 2)))
+        print(
+            f"[Cosmos3_Nano] ready: checkpoint iteration {checkpoint_iteration(checkpoint)}, "
+            f"num_steps={self.num_steps} guidance={self.guidance} shift={self.shift} "
+            f"actions_per_call={self.actions_per_call}",
+            flush=True,
+        )
+
+    def _setup(self, model_cfg: dict[str, Any], settings: dict[str, Any], model: Any) -> None:
+        """Everything but loading (tests call this with a stand-in model)."""
+        self.model_cfg = model_cfg
+        self.model = model
+        self.layout = action_layout(model_cfg["env_cfg_type"])
+        self.inputs = InputBuilder(settings["dataset"])
+        self.default_prompt = model_cfg.get("default_prompt") or model_cfg.get("task_name") or ""
+        self.num_steps = int(model_cfg.get("num_steps", 30))
+        self.guidance = float(model_cfg.get("guidance", 1.0))
+        self.shift = float(model_cfg.get("shift", 5.0))
+        self.actions_per_call = int(model_cfg.get("actions_per_call", self.inputs.chunk_length))
+        if not 1 <= self.actions_per_call <= self.inputs.chunk_length:
+            raise ValueError(f"actions_per_call must be in 1..{self.inputs.chunk_length}")
+        # One noise seed per call, from a stream seeded by the shard seed (as the RoboLab server).
+        self._rng = np.random.default_rng(int(model_cfg.get("seed") or 0))
+        self._obs_list: list[dict[str, Any]] = []
+        self._call_ms: list[float] = []
+
+    def _predict(self, obs: dict[str, Any]) -> np.ndarray:
+        """Observation -> [chunk_length, 14] absolute joint targets."""
+        images, state, prompt = parse_observation(obs, self.layout, self.default_prompt)
+        batch = build_data_batch(self.inputs.build(images, state, prompt))
+        start = time.monotonic()
+        with torch.inference_mode():
+            samples = self.model.generate_samples_from_batch(
+                batch,
+                guidance=self.guidance,
+                seed=[int(self._rng.integers(0, 2**31))],
+                num_steps=self.num_steps,
+                shift=self.shift,
+            )
+        chunk = decode_actions(samples["action"][0], self.inputs.stats)
+        self._call_ms.append((time.monotonic() - start) * 1000.0)
+        n = len(self._call_ms)
+        if n <= 3 or n % 100 == 0:
+            print(f"[Cosmos3_Nano] call {n}: {self._call_ms[-1]:.0f} ms (median {statistics.median(self._call_ms):.0f} ms)", flush=True)
+        if chunk.shape != (self.inputs.chunk_length, ROBOTWIN_ACTION_DIM):
+            raise RuntimeError(f"expected a {self.inputs.chunk_length}x14 action chunk, got {chunk.shape}")
+        return chunk
+
+    def _warmup(self, calls: int) -> None:
+        """Compile before the server opens its port (a first call can outlast the client's 120 s timeout)."""
+        mid = ((self.inputs.stats["q01"] + self.inputs.stats["q99"]) / 2).numpy()
+        gray = np.full((*TRAIN_CAMERA_HW, 3), 128, dtype=np.uint8)
+        state = {key: mid[start:end] for key, start, end in self.layout}
+        prompts = ["Warm up.", "Warm up the policy server with a longer instruction so dynamic shapes compile."]
+        for i in range(calls):
+            obs = {"instruction": prompts[i % 2], "vision": {c[0]: {"color": gray} for c in CAMERA_CANDIDATES}, "state": state}
+            start = time.monotonic()
+            self._predict(obs)
+            print(f"[Cosmos3_Nano] warm-up call {i + 1}/{calls}: {time.monotonic() - start:.0f} s", flush=True)
+        self._call_ms.clear()
+
+    def update_obs(self, obs):
+        self.update_obs_batch([obs])
+
+    def update_obs_batch(self, obs_list):
+        self._obs_list = list(obs_list)
+
+    def get_action(self, **kwargs):
+        if not self._obs_list:
+            raise AssertionError("update_obs or update_obs_batch first!")
+        return self.get_action_batch()[0]
+
+    def get_action_batch(self, env_idx_list=None, **kwargs):
+        if not self._obs_list:
+            raise AssertionError("update_obs or update_obs_batch first!")
+        return [to_env_actions(self._predict(obs)[: self.actions_per_call], self.layout) for obs in self._obs_list]
+
+    def reset(self):
+        self._obs_list = []
