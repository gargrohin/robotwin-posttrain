+# Basic experiment configuration (per-run fields are overridden at launch)
+policy_name: Cosmos3_Nano
+protocol: ws
+host: localhost
+port: null
+bench_name: null
+task_name: null
+ckpt_name: null
+env_cfg_type: null
+seed: null            # also seeds the per-call sampling noise stream
+action_type: joint    # absolute joint positions (the only supported value)
+gpu_id: null
+eval_batch: false
+
+# Checkpoint: the cosmos-framework training output dir (config.yaml + checkpoints/iter_<N>).
+# null = resolve from ckpt_name (a path, or checkpoints/<ckpt_name> under this policy dir).
+run_dir: null
+checkpoint_num: last  # training iteration (e.g. 1500), or last = checkpoints/latest_checkpoint.txt
+experiment: null      # null = the run's job.name (action_policy_robotwin_nano)
+use_ema_weights: true # evaluate the EMA weights, as cosmos-framework inference does by default
+
+# Sampling, as NVIDIA's LIBERO policy server (action_policy_server_libero.py)
+num_steps: 30
+guidance: 1.0         # 1.0 = no classifier-free guidance (one forward per step)
+shift: 5.0            # UniPC shift; generate_samples_from_batch's default
+actions_per_call: 16  # actions returned (and executed) per query, of the 16 generated
+
+# Runtime
+use_torch_compile: true
+warmup_calls: 2       # compile before the port opens (the sim client times out a call after 120 s)
+default_prompt: null  # used only if an observation has no instruction (falls back to task_name)
