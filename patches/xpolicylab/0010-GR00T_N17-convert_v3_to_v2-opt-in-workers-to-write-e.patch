+def _run_jobs(fn, jobs: list[tuple], workers: int, desc: str) -> None:
+    """Run ``fn(*job)`` for every job, in order (workers <= 1) or on ``workers`` threads.
+
+    Threads are enough: each job is an ffmpeg subprocess or a pyarrow write, which release the GIL.
+    Every job writes its own output file, so the result does not depend on the order they finish.
+    The first failure is re-raised.
+    """
+
+    if workers <= 1:
+        for job in tqdm.tqdm(jobs, desc=desc):
+            fn(*job)
+        return
+
+    with ThreadPoolExecutor(max_workers=workers) as pool:
+        futures = [pool.submit(fn, *job) for job in jobs]
+        try:
+            for future in tqdm.tqdm(as_completed(futures), total=len(futures), desc=desc):
+                future.result()
+        except BaseException:
+            pool.shutdown(wait=True, cancel_futures=True)
+            raise
+
+
