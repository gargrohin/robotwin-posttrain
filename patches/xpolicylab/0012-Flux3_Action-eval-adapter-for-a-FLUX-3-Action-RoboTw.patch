+# Basic experiment configuration (per-run fields are overridden at launch)
+policy_name: Flux3_Action
+protocol: ws
+host: localhost
+port: null
+bench_name: null
+task_name: null
+ckpt_name: null
+env_cfg_type: null
+seed: null            # also sets the per-query noise seeds (seed * 1e6 + query number)
+action_type: joint    # absolute joint positions (the only supported value)
+gpu_id: null
+eval_batch: false
+
+# Checkpoint: a folder of inference exports step-<N>/{config.json, model.safetensors, manifest.json}
+# (flux-action export-checkpoint --profile ema_0p10 --dtype bfloat16).
+# null = resolve from ckpt_name (a path, or checkpoints/<ckpt_name> under this policy dir).
+export_root: null
+checkpoint_num: last  # training step (e.g. 1500), or last = the highest step-<N> in export_root
+video_vae_path: null  # video_vae.safetensors of flux-3-action-base (required)
+text_encoder_path: null  # text_encoder/ (Qwen3-VL-4B) of flux-3-action-base (required)
+
+# Sampling: null = flux-action's DROID reference inference settings (DROID_INFERENCE_SETTINGS):
+# cosmos_unipc, 4 steps, shift 5.0, guidance 4.0 on video tokens and 1.0 (none) on action tokens.
+sampler: null
+num_inference_steps: null
+sampler_shift: null
+guidance_scale: null
+guidance_scale_action: null
+actions_per_call: null  # actions returned (and executed) per query; null = n_action_steps (32)
+
+# Runtime
+warmup_calls: 1       # requests answered before the port opens (flux-action serve-robolab --warmup 1)
+default_prompt: null  # used only if an observation has no instruction (falls back to task_name)
