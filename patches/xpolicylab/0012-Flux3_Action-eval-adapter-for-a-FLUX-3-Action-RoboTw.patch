+++ b/policy/Flux3_Action/model.py
@@ -0,0 +1,294 @@
+"""XPolicyLab adapter for a FLUX 3 Action policy fine-tuned on RoboTwin (aloha_agilex).
+
+The model is Black Forest Labs' FLUX 3 Action (flux-action), fully fine-tuned with the DROID
+recipe on RoboTwin demos: 14-D absolute joint targets, three cameras in the ``droid`` layout
+(head camera on top, both wrist cameras at half size below), chunks of 32 actions at 15 Hz.
+
+Weights come from an inference export of a training checkpoint
+(``flux-action export-checkpoint --profile ema_0p10 --dtype bfloat16``): ``<export_root>/step-<N>/``
+holds ``config.json`` (the run's ``PolicyConfig``, including the index's q01/q99 normalization),
+``model.safetensors`` and ``manifest.json`` (sha256 of both, verified on load). The frozen video
+VAE and Qwen3-VL text encoder are loaded from local paths given here (the export records the
+training job's paths).
+
+Per query the adapter hands flux-action's own inference API (``predict_action_chunk``) the
+observation in the training batch format:
+
+* ``images.high``, ``images.left_wrist``, ``images.right_wrist``: the RoboTwin head, left wrist and
+  right wrist cameras, RGB uint8 as the server delivers them (240x320, the training videos' size),
+  resized to the 360x640 the trainer decoded them at, with the policy's own camera resize
+  (bilinear, rounded back to uint8). The policy composes the canvas, encodes it and denoises.
+* ``state``: ``[left arm (6), left gripper, right arm (6), right gripper]`` in dataset units
+  (the training data's ``observation.state`` order); the policy normalizes it.
+* ``task``: the observation's instruction.
+
+The policy returns 32 absolute joint targets (denormalized), sent back in the per-step dict format
+of the GR00T_N17 adapter. Sampling uses the DROID reference inference settings from flux-action
+(``DROID_INFERENCE_SETTINGS``), and each query gets its own noise seed, as flux-action's RoboLab
+server does. Runs in the flux-action environment.
+"""
+
+from __future__ import annotations
+
+import json
+import statistics
+import time
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+
+from flux_action.config import DROID_INFERENCE_SETTINGS
+from flux_action.policy import FluxActionPolicy
+from XPolicyLab.model_template import ModelTemplate
+from XPolicyLab.utils.checkpoint_resolver import resolve_checkpoint_root
+from XPolicyLab.utils.process_data import get_robot_action_dim_info
+
+_POLICY_DIR = Path(__file__).resolve().parent
+_CHECKPOINTS_DIR = _POLICY_DIR / "checkpoints"
+
+# Observation cameras -> the policy's camera streams, in its layout order (head on top, then the
+# left and right wrist; index manifest: high = cam_high, left_wrist, right_wrist).
+CAMERAS = (
+    ("images.high", ("cam_head", "cam_high", "head_camera")),
+    ("images.left_wrist", ("cam_left_wrist", "left_camera")),
+    ("images.right_wrist", ("cam_right_wrist", "right_camera")),
+)
+TRAIN_CAMERA_HW = (240, 320)  # every camera of the training videos (index manifest camera_hw)
+MODEL_CAMERA_HW = (360, 640)  # the trainer's frame_hw: frames were rescaled to this when decoded
+STATE_KEYS = ("left_arm_joint_state", "left_ee_joint_state", "right_arm_joint_state", "right_ee_joint_state")
+# deploy.yml keys that map to PolicyConfig sampling fields (defaults: DROID_INFERENCE_SETTINGS).
+SAMPLING_KEYS = ("sampler", "num_inference_steps", "sampler_shift", "guidance_scale", "guidance_scale_action")
+
+
+def action_layout(env_cfg_type: str, action_dim: int) -> tuple[tuple[str, int, int], ...]:
+    """(state/action key, start, end) per part of the flat vector, from the robot's registered dims."""
+    dims = get_robot_action_dim_info(env_cfg_type)
+    sizes = (dims["arm_dim"][0], dims["ee_dim"][0], dims["arm_dim"][1], dims["ee_dim"][1])
+    if len(dims["arm_dim"]) != 2 or sum(sizes) != action_dim:
+        raise ValueError(f"{env_cfg_type}: dims {dims} do not match the model's {action_dim}-D action")
+    starts = np.cumsum((0,) + sizes[:-1])
+    return tuple((key, int(start), int(start + size)) for key, start, size in zip(STATE_KEYS, starts, sizes))
+
+
+# ---- export --------------------------------------------------------------------------------
+
+
+def resolve_export_root(model_cfg: dict[str, Any]) -> Path:
+    """The folder of ``step-<N>`` exports: export_root, else ckpt_name as a path, else
+    checkpoints/<ckpt_name> under this policy (e.g. a symlink), per the shared resolver."""
+    return resolve_checkpoint_root(model_cfg, _CHECKPOINTS_DIR, policy_dir=_POLICY_DIR, explicit_keys=("export_root",))
+
+
+def resolve_export(export_root: str | Path, checkpoint_num: Any) -> Path:
+    """``<export_root>/step-<N>`` for N = checkpoint_num (a training step), or the highest step for "last"."""
+    root = Path(export_root)
+    if checkpoint_num in (None, "last", "latest"):
+        steps = sorted(int(p.name.removeprefix("step-")) for p in root.glob("step-*") if (p / "manifest.json").is_file())
+        if not steps:
+            raise FileNotFoundError(f"no step-<N>/manifest.json under {root}")
+        checkpoint_num = steps[-1]
+    path = root / f"step-{int(str(checkpoint_num).removeprefix('step-'))}"
+    if not (path / "manifest.json").is_file():
+        raise FileNotFoundError(f"{path}/manifest.json not found (export the checkpoint with flux-action export-checkpoint)")
+    return path
+
+
+def export_step(export: Path) -> int:
+    return int(export.name.removeprefix("step-"))
+
+
+def sampling_settings(model_cfg: dict[str, Any]) -> dict[str, Any]:
+    """DROID_INFERENCE_SETTINGS, with deploy.yml values where they are set (n_action_steps stays 32)."""
+    settings = dict(DROID_INFERENCE_SETTINGS)
+    for key in SAMPLING_KEYS:
+        if model_cfg.get(key) is not None:
+            settings[key] = type(DROID_INFERENCE_SETTINGS[key])(model_cfg[key])
+    return settings
+
+
+def load_policy(
+    export: Path,
+    *,
+    video_vae_path: str,
+    text_encoder_path: str,
+    settings: dict[str, Any],
+    device: str = "cuda",
+    warmup: int = 1,
+) -> FluxActionPolicy:
+    """Restore the export on the CPU with the given encoders, then prepare it for serving on ``device``
+    the way flux-action's RoboLab server does (sampling settings applied, bf16, one warm-up request).
+
+    Prepared (compiled) inference exists only for the released DROID geometry; this 14-D policy runs
+    flux-action's reference inference path, eagerly."""
+    from flux_action.models.text_encoder import load_text_encoder
+    from flux_action.models.video_vae import load_video_vae
+    from flux_action.serving.robolab import prepare_serving_policy
+
+    policy = FluxActionPolicy.from_pretrained(
+        export, video_vae=load_video_vae(video_vae_path), text_encoder=load_text_encoder(text_encoder_path), device="cpu"
+    )
+    settings = {**settings, "video_vae_id": video_vae_path, "text_encoder_id": text_encoder_path}
+    return prepare_serving_policy(policy, device=device, dtype="bfloat16", settings=settings, compile_dit=False, warmup=warmup)
+
+
+def check_policy_config(config) -> None:
+    """The training contract this adapter serves."""
+    expected = {
+        "camera_layout": "droid",
+        "camera_keys": tuple(key for key, _ in CAMERAS),
+        "action_parameterization": "absolute",
+        "inference_profile": "default",
+        "gripper_flip_dims": (),
+        "rtc_max_prefix": 0,
+    }
+    got = {key: getattr(config, key) for key in expected}
+    if got != expected:
+        raise ValueError(f"export does not match the RoboTwin recipe: {got} != {expected}")
+    if config.action_normalization is None or config.state_normalization is None:
+        raise ValueError("export has no q01/q99 normalization (expected the LeRobot index statistics)")
+
+
+# ---- observation -> policy batch (CPU) --------------------------------------------------------
+
+
+def parse_observation(
+    obs: dict[str, Any], layout: tuple[tuple[str, int, int], ...], default_prompt: str
+) -> tuple[list[np.ndarray], np.ndarray, str]:
+    """XPolicyLab observation -> ([head, left wrist, right wrist] uint8 HxWx3 RGB, state [14], prompt)."""
+    vision = obs.get("vision", {})
+    images = []
+    for _, candidates in CAMERAS:
+        name = next((c for c in candidates if c in vision), None)
+        if name is None:
+            raise KeyError(f"observation has none of the cameras {candidates}; got {list(vision)}")
+        image = vision[name]["color"] if isinstance(vision[name], dict) else vision[name]
+        image = np.asarray(image)
+        if image.dtype != np.uint8 or image.shape != (*TRAIN_CAMERA_HW, 3):
+            raise ValueError(
+                f"{name}: expected uint8 {TRAIN_CAMERA_HW + (3,)} RGB as in training, got {image.dtype} {image.shape}"
+            )
+        images.append(image)
+
+    state = obs["state"]
+    parts = []
+    for key, start, end in layout:
+        value = np.asarray(state[key], dtype=np.float32).reshape(-1)
+        if value.shape[0] != end - start:
+            raise ValueError(f"state {key}: expected {end - start} values, got {value.shape[0]}")
+        parts.append(value)
+
+    prompt = obs.get("instruction") or (obs.get("instructions") or [None])[0] or default_prompt
+    return images, np.concatenate(parts), str(prompt).strip()
+
+
+def camera_tensor(image: np.ndarray) -> torch.Tensor:
+    """uint8 HxWx3 RGB -> uint8 (1, 3, 360, 640), resized with the policy's own camera resize."""
+    pixels = torch.from_numpy(np.array(image, dtype=np.uint8)).permute(2, 0, 1)[None]  # copy: decoded arrays are read-only
+    if tuple(pixels.shape[-2:]) != MODEL_CAMERA_HW:
+        pixels = FluxActionPolicy._resize_camera(pixels[:, None], MODEL_CAMERA_HW)[:, 0]
+    return pixels.contiguous()
+
+
+def build_batch(images: list[np.ndarray], state: np.ndarray, prompt: str, device: str | torch.device) -> dict[str, Any]:
+    """One observation in the training batch format (batch of one) on ``device``."""
+    batch: dict[str, Any] = {key: camera_tensor(image).to(device) for (key, _), image in zip(CAMERAS, images)}
+    batch["state"] = torch.from_numpy(np.asarray(state, dtype=np.float32).copy())[None].to(device)
+    batch["task"] = [prompt]
+    return batch
+
+
+def to_env_actions(chunk: np.ndarray, layout: tuple[tuple[str, int, int], ...]) -> list[dict[str, np.ndarray]]:
+    """[T, 14] -> one dict per step, the format the GR00T_N17 adapter returns."""
+    return [{key: step[start:end].copy() for key, start, end in layout} for step in np.asarray(chunk, dtype=np.float32)]
+
+
+# ---- XPolicyLab Model ------------------------------------------------------------------------
+
+
+class Model(ModelTemplate):
+    def __init__(self, model_cfg: dict[str, Any]):
+        if model_cfg.get("action_type", "joint") != "joint":
+            raise ValueError(f"Flux3_Action predicts absolute joint positions; got action_type={model_cfg['action_type']!r}")
+        export = resolve_export(resolve_export_root(model_cfg), model_cfg.get("checkpoint_num", "last"))
+        for key in ("video_vae_path", "text_encoder_path"):
+            if not model_cfg.get(key):
+                raise ValueError(f"deploy.yml {key} is required (the export records the training job's paths)")
+        manifest = json.loads((export / "manifest.json").read_text())
+        print(f"[Flux3_Action] loading {export} (weights: {manifest.get('weight_profile')})", flush=True)
+        start = time.monotonic()
+        policy = load_policy(
+            export,
+            video_vae_path=str(model_cfg["video_vae_path"]),
+            text_encoder_path=str(model_cfg["text_encoder_path"]),
+            settings=sampling_settings(model_cfg),
+            warmup=int(model_cfg.get("warmup_calls", 1)),
+        )
+        print(f"[Flux3_Action] loaded in {time.monotonic() - start:.0f} s; serving setup {policy.serving_setup}", flush=True)
+        self._setup(model_cfg, policy, device=policy.device)
+        self.export = export
+        self.weight_profile = manifest.get("weight_profile")
+        c = policy.config
+        print(
+            f"[Flux3_Action] ready: step {export_step(export)} ({self.weight_profile}), dtype {c.torch_dtype}, "
+            f"sampler={c.sampler} steps={c.num_inference_steps} shift={c.sampler_shift} "
+            f"guidance={c.guidance_scale}/{c.guidance_scale_action} actions_per_call={self.actions_per_call}",
+            flush=True,
+        )
+
+    def _setup(self, model_cfg: dict[str, Any], policy: FluxActionPolicy, *, device: str | torch.device) -> None:
+        """Everything but loading (tests call this with a policy whose sampler is a stand-in)."""
+        check_policy_config(policy.config)
+        self.model_cfg = model_cfg
+        self.model = policy
+        self.device = torch.device(device)
+        self.chunk_size = policy.config.chunk_size
+        self.action_dim = policy.config.action_dim
+        self.layout = action_layout(model_cfg["env_cfg_type"], self.action_dim)
+        self.default_prompt = model_cfg.get("default_prompt") or model_cfg.get("task_name") or ""
+        self.actions_per_call = int(model_cfg.get("actions_per_call") or policy.config.n_action_steps)
+        if not 1 <= self.actions_per_call <= self.chunk_size:
+            raise ValueError(f"actions_per_call must be in 1..{self.chunk_size}")
+        # Query n of this server gets noise seed seed_base + n, as flux-action's RoboLab server
+        # (RoboLabPolicy: seed_base + query count); seed_base separates the shards' streams.
+        self.seed_base = int(model_cfg.get("seed") or 0) * 1_000_000
+        self.queries = 0
+        self._obs_list: list[dict[str, Any]] = []
+        self._call_ms: list[float] = []
+
+    def _predict(self, obs: dict[str, Any]) -> np.ndarray:
+        """Observation -> [chunk_size, 14] absolute joint targets."""
+        images, state, prompt = parse_observation(obs, self.layout, self.default_prompt)
+        batch = build_batch(images, state, prompt, self.device)
+        self.queries += 1
+        self.model.config.inference_seed = self.seed_base + self.queries  # predict_action_chunk's noise seed
+        start = time.monotonic()
+        with torch.inference_mode():
+            chunk = self.model.predict_action_chunk(batch)[0].float().cpu().numpy()
+        self._call_ms.append((time.monotonic() - start) * 1000.0)
+        n = len(self._call_ms)
+        if n <= 3 or n % 100 == 0:
+            print(f"[Flux3_Action] call {n}: {self._call_ms[-1]:.0f} ms (median {statistics.median(self._call_ms):.0f} ms)", flush=True)
