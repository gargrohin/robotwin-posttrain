From a58f046216fc7bc1837fecf3a52e328ed800c7a1 Mon Sep 17 00:00:00 2001
From: gargrohin <29701609+gargrohin@users.noreply.github.com>
Date: Mon, 2 Nov 2026 07:50:28 +0000
Subject: [PATCH 6/8] RoboTwin smoke test: bound normalized range by the
 measured dataset max

The previous commit message understated the base-joint tail: over the whole
mix200 set the left base joint normalizes to at most 11.7 and the right base
joint to 15.33 (all other dims within 4). Bound the check at 16 and state the
measured maxima in the comment. With this, all 31 checks pass on CPU.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/robotwin_dataset_smoke_test.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/tools/robotwin_dataset_smoke_test.py b/tools/robotwin_dataset_smoke_test.py
index f6086f8..5e10423 100644
--- a/tools/robotwin_dataset_smoke_test.py
+++ b/tools/robotwin_dataset_smoke_test.py
@@ -145,9 +145,10 @@ def main() -> int:
     for d in range(14):
         print(f"  dim {d:2d}: min={flat[:, d].min():+.3f} max={flat[:, d].max():+.3f} outside[-1,1]={outside[d]:.3%}")
     # q01/q99 put ~2% of values outside [-1, 1] per dim. The base joints (dims 0 and 7) have a
-    # thin tail past +-2 pi in ~1% of episodes (normalized up to ~11 over the whole dataset).
+    # thin tail past +-2 pi in ~1% of episodes; over the whole mix200 set they normalize to at
+    # most 11.7 (left) and 15.33 (right); every other dim stays within 4.
     check(bool((outside <= 0.025).all()), f"<= 2.5% outside [-1, 1] in every dim (max {outside.max():.2%})")
-    check(bool(np.isfinite(flat).all()) and np.abs(flat).max() < 15.0, f"finite, max |normalized| = {np.abs(flat).max():.2f} (< 15)")
+    check(bool(np.isfinite(flat).all()) and np.abs(flat).max() < 16.0, f"finite, max |normalized| = {np.abs(flat).max():.2f} (< 16)")
 
     # ---- streaming iterator ------------------------------------------------------
     print("\n[streaming iterator]")
-- 
