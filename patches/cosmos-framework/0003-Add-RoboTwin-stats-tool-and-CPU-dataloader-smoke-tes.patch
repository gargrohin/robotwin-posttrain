@@ -0,0 +1,93 @@
+"""Compute RoboTwin action normalization stats and build the dataset index cache.
+
+Reads a RoboTwin LeRobot v2.1 root once (or its index cache, if it already exists),
+computes exact per-dimension stats over every frame's ``action`` row, and writes the flat
+stats JSON that ``load_action_stats`` and the policy servers read (``q01``, ``q99``,
+``mean``, ``std``, ``min``, ``max``; same keys as ``tools/compute_action_stats.py``, which
+instead iterates ``LeRobotDataset`` sample by sample and uses a 50k-row reservoir for the
+quantiles), plus a ``metadata`` block that loaders ignore.
+
+The dataset normalizes the conditioning state row with these same stats; since
+``action[t] == state[t+1]`` the two distributions match, and the script prints the largest
+difference between them as a check.
+
+Usage (from the repo root, in the training venv):
+
+    python tools/compute_robotwin_action_stats.py \
+        --dataset-root /path/to/RoboTwin-mix200-aloha_agilex-joint \
+        --index-cache /path/to/cache/RoboTwin-mix200-aloha_agilex-joint.index.npz
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+
+from cosmos_framework.data.generator.action.datasets.robotwin_lerobot_dataset import (
+    ROBOTWIN_DEFAULT_STATS_PATH,
+    load_robotwin_index,
+)
+
+_DIM_NAMES = [f"{side}_joint_{i}" for side in ("left", "right") for i in range(7)]
+
+
+def compute_stats(values: np.ndarray) -> dict[str, list[float]]:
+    """Exact per-dimension stats of a ``[N, D]`` array (population std, linear-interpolated quantiles)."""
+    x = values.astype(np.float64)
+    q01, q99 = np.quantile(x, [0.01, 0.99], axis=0)
+    return {
+        "q01": q01.tolist(),
+        "q99": q99.tolist(),
+        "mean": x.mean(axis=0).tolist(),
+        "std": x.std(axis=0).tolist(),
+        "min": x.min(axis=0).tolist(),
+        "max": x.max(axis=0).tolist(),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--dataset-root", type=Path, required=True, help="RoboTwin LeRobot v2.1 root.")
+    parser.add_argument("--index-cache", type=Path, required=True, help="Index .npz to load, or build if missing.")
+    parser.add_argument("--output", type=Path, default=ROBOTWIN_DEFAULT_STATS_PATH, help="Stats JSON to write.")
+    args = parser.parse_args()
+
+    t0 = time.time()
+    index = load_robotwin_index(args.dataset_root, args.index_cache)
+    print(f"index: {len(index['episode_index'])} episodes, {len(index['action'])} frames ({time.time() - t0:.1f} s)")
+
+    stats = compute_stats(index["action"])
+    state_stats = compute_stats(index["state"])
+    for key in ("q01", "q99", "mean", "std"):
+        diff = np.abs(np.array(stats[key]) - np.array(state_stats[key])).max()
+        print(f"max |action - state| {key}: {diff:.2e}")
+    spread = np.array(stats["q99"]) - np.array(stats["q01"])
+    for name, s in zip(_DIM_NAMES, spread):
+        if s < 1e-3:
+            print(f"WARNING: {name} has q99 - q01 = {s:.2e}; quantile normalization will blow it up")
+
+    payload = {
+        **stats,
+        "metadata": {
+            "dataset_root": str(args.dataset_root.resolve()),
+            "source_key": "action",
+            "num_frames": int(len(index["action"])),
+            "num_episodes": int(len(index["episode_index"])),
+            "dim_names": _DIM_NAMES,
+            "normalization": "quantile",
+            "quantiles": "exact over all frames (numpy linear interpolation)",
+        },
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
+    print(f"wrote {args.output}")
+    for name, lo, hi, mn, mx in zip(_DIM_NAMES, stats["q01"], stats["q99"], stats["min"], stats["max"]):
+        print(f"  {name:16s} q01={lo:+.4f} q99={hi:+.4f}  min={mn:+.4f} max={mx:+.4f}")
+
+
+if __name__ == "__main__":
+    main()
